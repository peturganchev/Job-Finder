# ============================================================
# Job Finder Configuration
# ============================================================

# Google Gemini API Key (Вземи безплатно от https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Избор на модел (gemini-2.5-flash е бърз и безплатен, gemini-2.5-pro за дълбок анализ)
GEMINI_MODEL=gemini-2.5-flash

# Discord Webhook (Опционално, създава се в Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=

# Telegram Bot (Опционално, създава се през @BotFather в Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Браузърни настройки
HEADLESS=false
CHROME_PATH=
