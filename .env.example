# ============================================================
# Job Finder Configuration
# ============================================================

# Google Gemini API Key (Вземи безплатно от https://aistudio.google.com/)
# Може да се въведе и от дашборда: таб "⚙️ Настройки" (записва се в data/user_settings.json).
# Ключът от дашборда има приоритет пред този тук.
GEMINI_API_KEY=your_gemini_api_key_here

# Модел по подразбиране (gemini-3.5-flash, gemini-3.5-flash-lite, gemini-2.5-pro)
GEMINI_MODEL=gemini-3.5-flash

# Discord Webhook (Опционално, създава се в Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=

# Telegram Bot (Опционално, създава се през @BotFather в Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LinkedIn Session Cookie (li_at)
LINKEDIN_LI_AT=

# Браузърни настройки
HEADLESS=false
CHROME_PATH=
